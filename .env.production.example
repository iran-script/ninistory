APP_NAME=Kidoki
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://kidoki.ir
APP_LOCALE=fa
APP_FALLBACK_LOCALE=en
APP_TIMEZONE=Asia/Tehran

SEO_INDEXING_ENABLED=true
SEO_PRODUCTION_URL=https://kidoki.ir

PAYMENT_GATEWAY=mock
PAYMENT_MOCK_ENABLED=false
PAYMENT_ATTEMPT_TTL_MINUTES=15
PAYMENT_RECONCILIATION_ENABLED=false

LOG_CHANNEL=stderr
LOG_STACK=single
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=kidoki
DB_USERNAME=kidoki_app
DB_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_SECRET
DB_SSLMODE=prefer

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=.kidoki.ir
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=redis
CACHE_STORE=redis
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS=no-reply@kidoki.ir
MAIL_FROM_NAME="Kidoki | کیدوکی"

TRUSTED_PROXIES=*
KIDOKI_HTTP_PORT=18082
KIDOKI_IMAGE_TAG=local
KIDOKI_APP_IMAGE=ghcr.io/iran-script/ninistory-app:REPLACE_WITH_RELEASE_TAG
KIDOKI_WEB_IMAGE=ghcr.io/iran-script/ninistory-web:REPLACE_WITH_RELEASE_TAG
KIDOKI_POSTGRES_IMAGE=postgres:16-alpine
KIDOKI_REDIS_IMAGE=redis:7-alpine
KIDOKI_PG_VOLUME=kidoki_pgdata
KIDOKI_REDIS_VOLUME=kidoki_redisdata
KIDOKI_STORAGE_VOLUME=kidoki_storage
KIDOKI_NETWORK_NAME=kidoki_internal
