# Production-oriented example. Adapt the server_name, root, TLS, and PHP socket.
# Do not apply this file to local development automatically.
location ~* \.(?:css|js|mjs|woff2|webp|avif|png|jpg|jpeg|svg|ico)$ {
    expires 1y;
    add_header Cache-Control "public, max-age=31536000, immutable";
    access_log off;
    try_files $uri =404;
}

location / {
    try_files $uri $uri/ /index.php?$query_string;
}

location ~ \.php$ {
    include fastcgi_params;
    fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
    fastcgi_pass unix:/run/php/php8.5-fpm.sock;
    fastcgi_read_timeout 60s;
}

gzip on;
gzip_types text/css application/javascript application/json application/xml image/svg+xml;
gzip_min_length 1024;
